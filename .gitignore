# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# Environments
.env
.venv
venv/
env/
ENV/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints
*.ipynb

# Local Legacy, Scratch & Agent skills
legacy/
scratch/
.agents/
docs/

# Data (strictly excluded proprietary CFD files)
data/raw/
data/processed/
*.xlsx
*.xls
*.parquet
*.h5
*.csv

# Whitelist public demonstration datasets
!data/demo/
!data/demo/*.csv


# Models (strictly excluded)
models/
*.joblib
*.pkl
*.pt
*.pth
*.onnx

# Output Results, Plots & Figures (strictly excluded)
results/
plots/
figures/
*.png
*.svg
*.pdf
*.jpg
*.jpeg

# Whitelist assets (e.g. conference poster QR codes)
!assets/
!assets/**

# Logs
*.log
logs/

